{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["svelte", "node"]
  },
  "include": ["frontend/src/**/*", "playwright.config.ts", "frontend/tests/**/*"]
}
